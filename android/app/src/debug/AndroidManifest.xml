<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- أندرويد يحظر الاتصال غير المشفّر (http) افتراضياً منذ API 28، فمناداة
         منسّق يعمل محلياً على http://10.0.2.2:8080 تفشل بخطأ اتصال مبهم.
         نسمح به في بناء التطوير وحده: ملف debug لا يدخل بناء الإصدار إطلاقاً،
         فيبقى الإنتاج ملزَماً بـ HTTPS. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
